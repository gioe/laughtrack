#!/usr/bin/env python3
"""
Discover comedy venues near a ZIP code via the Google Places API and diff the
results against the clubs already in our database.

Google Places Text Search biases results toward a circle whose radius the API
caps at 50 km (~31 mi). To cover a larger radius this tiles the target disk
with a grid of overlapping search centers, dedupes the hits on place_id, then
keeps only venues whose TRUE great-circle distance from the origin ZIP is
within --radius (the bias is soft, so Google returns some venues from beyond
the ring). Each hit is then classified against the clubs table:

    known   place_id already stored on clubs.google_place_id
    likely  name matches an existing club within ~2 mi, OR the street address
            (number + street word, format-tolerant) matches an existing club —
            probable same venue, place_id just not linked yet. The address arm
            catches clubs onboarded under a name variant and/or with a NULL
            place_id, which the name/place_id checks miss.
    new     no match — a candidate venue we don't track

Usage:
    cd apps/scraper && python bin/discover-nearby --zip 44622
    cd apps/scraper && python bin/discover-nearby --zip 44622 --radius 100
    cd apps/scraper && python bin/discover-nearby --zip 10001 --query "comedy" --new-only
    cd apps/scraper && python bin/discover-nearby --zip 44622 --format json
    make discover-nearby ZIP=44622 RADIUS=100

Needs GOOGLE_PLACES_API_KEY in apps/scraper/.env (each tile page is one
billable Text Search request, drawn from GOOGLE_PLACES_DAILY_LIMIT). Reads
DATABASE_URL from apps/scraper/.env (same fallback as bin/query).
"""

import argparse
import csv
import io
import json
import math
import os
import re
import sys
from dataclasses import dataclass
from pathlib import Path
from urllib.parse import quote

SCRIPT_DIR = Path(__file__).resolve().parent
SCRAPER_ROOT = SCRIPT_DIR.parent
ENV_FILE = SCRAPER_ROOT / ".env"

try:
    from dotenv import load_dotenv
except ImportError:
    print("Error: python-dotenv is not installed. Run: pip install python-dotenv", file=sys.stderr)
    sys.exit(1)

if not ENV_FILE.exists():
    print(f"Warning: .env not found at {ENV_FILE} — falling back to environment variables", file=sys.stderr)

load_dotenv(ENV_FILE)

# pgeocode (via ZipCodeDistance) downloads its dataset over HTTPS with urllib,
# which on macOS often can't find a system CA bundle and fails verification.
# Point it at certifi's bundle (a requests dependency, always present) unless
# the environment already specifies one.
if not os.environ.get("SSL_CERT_FILE"):
    try:
        import certifi

        os.environ["SSL_CERT_FILE"] = certifi.where()
        os.environ.setdefault("REQUESTS_CA_BUNDLE", certifi.where())
    except ImportError:
        pass

# src/ for the ``laughtrack`` package; the scraper root for the top-level
# ``sql`` package that the clients/entities import chain pulls in (it's
# normally resolved off the cwd, which a script file doesn't put on the path).
sys.path.insert(0, str(SCRAPER_ROOT))
sys.path.insert(0, str(SCRAPER_ROOT / "src"))

from laughtrack.core.clients.google.places import GooglePlacesClient  # noqa: E402
from laughtrack.core.services.notification.geo import (  # noqa: E402
    ZipCodeDistance,
    _haversine_miles,
)

_MILES_PER_LAT_DEGREE = 69.0


@dataclass(frozen=True)
class Classification:
    status: str
    club_id: int | None = None
    club_name: str | None = None
    category_state: str | None = None
    deny_reason: str | None = None
    deny_google_primary_type: str | None = None
    deny_evidence: dict | None = None

    def __iter__(self):
        """Keep older tests/callers that unpack ``status, club_id, club_name`` working."""
        yield self.status
        yield self.club_id
        yield self.club_name


def _resolve_database_url() -> str:
    """Resolve DATABASE_URL or compose one from the host-family vars."""
    url = os.environ.get("DATABASE_URL")
    if url:
        return url

    host = os.environ.get("DATABASE_HOST")
    user = os.environ.get("DATABASE_USER")
    password = os.environ.get("DATABASE_PASSWORD")
    name = os.environ.get("DATABASE_NAME")
    port = os.environ.get("DATABASE_PORT", "5432")

    missing = [
        var
        for var, val in (
            ("DATABASE_HOST", host),
            ("DATABASE_USER", user),
            ("DATABASE_PASSWORD", password),
            ("DATABASE_NAME", name),
        )
        if not val
    ]
    if missing:
        print(
            "Error: DATABASE_URL not set, and could not compose one from "
            f"DATABASE_HOST/USER/PASSWORD/NAME/PORT — missing: {', '.join(missing)}. "
            f"Set DATABASE_URL or the host-family vars in {ENV_FILE}",
            file=sys.stderr,
        )
        sys.exit(1)

    return f"postgresql://{quote(user, safe='')}:{quote(password, safe='')}" f"@{host}:{port}/{name}?sslmode=require"


def _normalize_name(name: str) -> str:
    """Lowercase and strip to alphanumerics for tolerant club-name matching."""
    return re.sub(r"[^a-z0-9]", "", (name or "").lower())


# Filler words dropped before token-subset name comparison so a venue listed as
# "X" matches a club stored as "X at Y" / "X of Y".
_NAME_STOPWORDS = frozenset({"at", "the", "of", "and", "a", "an"})


def _name_tokens(name: str) -> frozenset:
    """Set of meaningful lowercase word tokens in a club name (stopwords dropped)."""
    toks = re.split(r"[^a-z0-9]+", (name or "").lower())
    return frozenset(t for t in toks if t and t not in _NAME_STOPWORDS)


def _is_name_token_subset(a: frozenset, b: frozenset) -> bool:
    """True when the shorter name's meaningful tokens are a subset of the longer's.

    Catches "Great Cedar Showroom" vs "Great Cedar Showroom at Foxwoods Resort
    Casino" (an onboarded venue re-surfaced as new because its stored name is a
    longer variant). Requires the smaller set to have >= 2 tokens so a single
    generic word ("comedy") can't collapse unrelated venues; the caller's
    proximity check is the second guard against false positives.
    """
    if not a or not b:
        return False
    smaller, larger = (a, b) if len(a) <= len(b) else (b, a)
    return len(smaller) >= 2 and smaller <= larger


_STREET_DIRECTIONS = frozenset(
    {"n", "s", "e", "w", "ne", "nw", "se", "sw", "north", "south", "east", "west"}
)


def _normalize_address(address: str):
    """Street-identity key: ``"<number> <first street word>"`` or None.

    Built from the first comma-segment (the street line) as
    ``street_number + first non-directional street word`` so format variants
    collapse to the same key: "24 N Mentor Ave" / "24 N Mentor Avenue" and
    "1215 Baker St" / "1215 Baker Street, Unit C" all -> "24 mentor" / "1215 baker".
    Returns None when there is no leading street number (too weak to match on).
    This catches duplicates that the place_id and name checks miss — existing
    clubs onboarded under a name variant and/or with a NULL google_place_id.
    """
    seg = re.sub(r"[^a-z0-9 ]", " ", (address or "").split(",")[0].lower())
    toks = seg.split()
    if not toks or not toks[0].isdigit():
        return None
    word = next(
        (t for t in toks[1:] if t.isalpha() and t not in _STREET_DIRECTIONS and len(t) > 2),
        "",
    )
    return f"{toks[0]} {word}".strip() if word else None


def _tile_centers(lat, lng, radius_miles, spacing_miles):
    """Grid of search centers covering the radius-mile disk around (lat, lng).

    Steps a square grid by ``spacing_miles`` across the disk's bounding box and
    keeps only centers within ``radius_miles`` of the origin (plus the origin
    itself). Longitude degrees are scaled by cos(lat) so spacing stays ~uniform
    in miles. Overlapping coverage is intentional — dedup on place_id collapses
    the repeats while the overlap reduces gaps between tiles.
    """
    lat_step = spacing_miles / _MILES_PER_LAT_DEGREE
    cos_lat = math.cos(math.radians(lat)) or 1e-9
    lng_step = spacing_miles / (_MILES_PER_LAT_DEGREE * cos_lat)

    steps = int(math.ceil(radius_miles / spacing_miles))
    centers = [(lat, lng)]
    seen = {(0, 0)}
    for i in range(-steps, steps + 1):
        for j in range(-steps, steps + 1):
            if (i, j) in seen:
                continue
            seen.add((i, j))
            c_lat = lat + i * lat_step
            c_lng = lng + j * lng_step
            if _haversine_miles(lat, lng, c_lat, c_lng) <= radius_miles:
                centers.append((c_lat, c_lng))
    return centers


def _load_existing_clubs(dsn):
    """Return existing clubs as (by_place_id dict, name_rows, addr_index)."""
    import psycopg2  # noqa: F401

    from laughtrack.foundation.db_util import connect_with_retry

    conn = connect_with_retry(dsn)
    try:
        conn.autocommit = True
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT id, name, address, latitude, longitude, google_place_id,
                       club_type, visible, status
                  FROM clubs
                """
            )
            rows = cur.fetchall()
    finally:
        conn.close()

    by_place_id = {}
    name_rows = []
    addr_index = {}
    for club_id, name, address, lat, lng, place_id, club_type, visible, status in rows:
        flat = float(lat) if lat is not None else None
        flng = float(lng) if lng is not None else None
        club_meta = (club_type or "club", bool(visible), status or "")
        if place_id:
            by_place_id[place_id] = (club_id, name, *club_meta)
        name_rows.append((club_id, name, _normalize_name(name), flat, flng, *club_meta))
        addr_key = _normalize_address(address)
        if addr_key:
            addr_index.setdefault(addr_key, []).append((club_id, name, flat, flng, *club_meta))
    return by_place_id, name_rows, addr_index


def _load_denied_venues(dsn):
    """Return Google place_id -> structured venue deny-list evidence.

    Venues are deny-listed after discovery when they are evaluated and rejected
    as non-comedy (e.g. live-music venues with no stand-up on their own
    calendar). Returns an empty dict if the table does not exist yet so the tool
    still runs against a DB that predates the venue_deny_list migration. If the
    table exists but predates the structured-evidence columns, fall back to the
    original place_id-only shape.
    """
    import psycopg2

    from laughtrack.foundation.db_util import connect_with_retry

    conn = connect_with_retry(dsn)
    try:
        conn.autocommit = True
        with conn.cursor() as cur:
            try:
                cur.execute(
                    """
                    SELECT google_place_id, name, reason, google_primary_type, evidence
                      FROM venue_deny_list
                    """
                )
                denied = {}
                for place_id, name, reason, google_primary_type, evidence in cur.fetchall():
                    if not place_id:
                        continue
                    denied[place_id] = {
                        "name": name,
                        "reason": reason,
                        "google_primary_type": google_primary_type,
                        "evidence": evidence if isinstance(evidence, dict) else {},
                    }
                return denied
            except psycopg2.errors.UndefinedColumn:
                conn.rollback()
                cur.execute("SELECT google_place_id, name, reason FROM venue_deny_list")
                return {
                    row[0]: {
                        "name": row[1],
                        "reason": row[2],
                        "google_primary_type": None,
                        "evidence": {},
                    }
                    for row in cur.fetchall()
                    if row[0]
                }
            except psycopg2.errors.UndefinedTable:
                return {}
    finally:
        conn.close()


def _within(venue, lat, lng, miles):
    """True if the club coords are within ``miles`` of the venue, or if proximity
    can't be checked (either side lacks coords). Without coords an exact name or
    street-address key match is itself strong identity, so we accept it."""
    if lat is None or lng is None or venue.lat is None or venue.lng is None:
        return True
    return _haversine_miles(venue.lat, venue.lng, lat, lng) <= miles


def _club_category_state(club_type, visible, status):
    base = club_type or "club"
    if visible is False and status == "active":
        return f"hidden_active:{base}"
    return base


def _split_club_match(row, meta_offset):
    club_id, club_name = row[0], row[1]
    club_type = row[meta_offset] if len(row) > meta_offset else "club"
    visible = row[meta_offset + 1] if len(row) > meta_offset + 1 else True
    status = row[meta_offset + 2] if len(row) > meta_offset + 2 else "active"
    return club_id, club_name, club_type, visible, status


def _match_by_name(venue, name_rows, name_match_miles):
    """Existing club with the same normalized name, proximity-confirmed when
    coords are available (so a chain like "Funny Bone" in two cities isn't
    collapsed). Returns (club_id, club_name) or None."""
    target = _normalize_name(venue.name)
    if not target:
        return None
    target_tokens = _name_tokens(venue.name)
    for row in name_rows:
        club_id, club_name, norm, lat, lng = row[:5]
        if not _within(venue, lat, lng, name_match_miles):
            continue
        # Exact normalized equality, or one name is a token-subset of the other
        # ("Great Cedar Showroom" vs "Great Cedar Showroom at Foxwoods ...").
        if norm == target or _is_name_token_subset(target_tokens, _name_tokens(club_name)):
            return _split_club_match(row, 5)
    return None


def _match_by_address(venue, addr_index, name_match_miles):
    """Existing club at the same street address (number + first street word,
    format-tolerant), proximity-confirmed when coords are available. Catches
    duplicates onboarded under a name variant and/or with a NULL google_place_id,
    which the name and place_id checks miss. Returns (club_id, club_name) or None."""
    addr_key = _normalize_address(venue.address)
    if not (addr_key and addr_index):
        return None
    for row in addr_index.get(addr_key, ()):
        club_id, club_name, lat, lng = row[:4]
        if _within(venue, lat, lng, name_match_miles):
            return _split_club_match(row, 4)
    return None


def _classify(
    venue,
    origin,
    by_place_id,
    name_rows,
    name_match_miles,
    denied_place_ids=frozenset(),
    denied_venues=None,
    addr_index=None,
):
    """Tag a discovered venue as denied / known / likely / new against existing clubs."""
    denied_venues = denied_venues or {}
    if venue.place_id in denied_venues or venue.place_id in denied_place_ids:
        evidence = denied_venues.get(venue.place_id, {})
        google_primary_type = evidence.get("google_primary_type") or getattr(venue, "primary_type", None)
        category_state = "denied"
        if google_primary_type:
            category_state = f"denied:{google_primary_type}"
        return Classification(
            "denied",
            category_state=category_state,
            deny_reason=evidence.get("reason"),
            deny_google_primary_type=google_primary_type,
            deny_evidence=evidence.get("evidence") or {},
        )
    if venue.place_id in by_place_id:
        club_id, club_name, club_type, visible, status = _split_club_match(
            by_place_id[venue.place_id], 2
        )
        return Classification(
            "known",
            club_id,
            club_name,
            category_state=_club_category_state(club_type, visible, status),
        )

    match = _match_by_name(venue, name_rows, name_match_miles) or _match_by_address(
        venue, addr_index, name_match_miles
    )
    if match:
        club_id, club_name, club_type, visible, status = match
        return Classification(
            "likely",
            club_id,
            club_name,
            category_state=_club_category_state(club_type, visible, status),
        )
    primary_type = getattr(venue, "primary_type", None)
    return Classification("new", category_state=f"google:{primary_type}" if primary_type else "uncategorized")


def main() -> None:
    parser = argparse.ArgumentParser(description="Discover comedy venues near a ZIP via Google Places.")
    parser.add_argument("--zip", required=True, help="Origin US ZIP code, e.g. 44622")
    parser.add_argument("--radius", type=float, default=100.0, help="Search radius in miles (default 100)")
    parser.add_argument("--query", default="comedy club", help='Text query (default "comedy club")')
    parser.add_argument(
        "--spacing",
        type=float,
        default=40.0,
        help="Miles between search tile centers (default 40; smaller = more API calls, fewer gaps)",
    )
    parser.add_argument(
        "--max-pages",
        type=int,
        default=3,
        help="Result pages per tile, 20 each, 3 = 60 max (default 3)",
    )
    parser.add_argument(
        "--name-match-miles",
        type=float,
        default=2.0,
        help="Proximity for same-name 'likely known' match (default 2)",
    )
    parser.add_argument("--new-only", action="store_true", help="Show only net-new venues")
    parser.add_argument("--format", choices=["table", "json", "csv"], default="table", help="Output format")
    parser.add_argument("--limit", type=int, help="Cap rows in output")
    args = parser.parse_args()

    client = GooglePlacesClient()
    if not client.is_configured:
        print(
            "Error: GOOGLE_PLACES_API_KEY is not set in " f"{ENV_FILE} — cannot run Places discovery.",
            file=sys.stderr,
        )
        sys.exit(1)

    origin = ZipCodeDistance().get_coords(args.zip)
    if origin is None:
        print(f"Error: could not resolve ZIP {args.zip!r} to coordinates.", file=sys.stderr)
        sys.exit(1)
    o_lat, o_lng = origin

    centers = _tile_centers(o_lat, o_lng, args.radius, args.spacing)
    # Per-tile bias radius: half the spacing covers the gap to the next center,
    # clamped to a 5 mi floor so tiny --spacing values still search a real area.
    tile_radius = max(args.spacing / 2.0, 5.0)
    print(
        f"Searching {len(centers)} tile(s) for {args.query!r} within "
        f"{args.radius:g} mi of {args.zip} ({o_lat:.4f},{o_lng:.4f})…",
        file=sys.stderr,
    )

    deduped = {}
    for c_lat, c_lng in centers:
        for venue in client.search_nearby(args.query, c_lat, c_lng, tile_radius, max_pages=args.max_pages):
            deduped[venue.place_id] = venue

    dsn = _resolve_database_url()
    by_place_id, name_rows, addr_index = _load_existing_clubs(dsn)
    denied_venues = _load_denied_venues(dsn)

    results = []
    for venue in deduped.values():
        dist = _haversine_miles(o_lat, o_lng, venue.lat, venue.lng)
        if dist > args.radius:
            continue
        classification = _classify(
            venue, origin, by_place_id, name_rows, args.name_match_miles,
            denied_venues=denied_venues, addr_index=addr_index,
        )
        if args.new_only and classification.status != "new":
            continue
        results.append(
            {
                "status": classification.status,
                "name": venue.name,
                "distance_mi": round(dist, 1),
                "address": venue.address,
                "website": venue.website,
                "primary_type": venue.primary_type,
                "business_status": venue.business_status,
                "category_state": classification.category_state,
                "place_id": venue.place_id,
                "matched_club_id": classification.club_id,
                "matched_club_name": classification.club_name,
                "deny_reason": classification.deny_reason,
                "deny_google_primary_type": classification.deny_google_primary_type,
                "deny_evidence": classification.deny_evidence,
            }
        )

    results.sort(key=lambda r: (r["distance_mi"], r["name"].lower()))
    if args.limit is not None:
        results = results[: args.limit]

    counts = {"new": 0, "likely": 0, "known": 0, "denied": 0}
    for r in results:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    print(
        f"Places API calls used this run: {client.calls_made} " f"({client.calls_remaining} remaining today)",
        file=sys.stderr,
    )
    print(
        f"{len(results)} venue(s): "
        f"{counts['new']} new, {counts['likely']} likely-known, {counts['known']} known, "
        f"{counts['denied']} deny-listed",
        file=sys.stderr,
    )

    _render(results, args.format)


_CSV_FIELDS = [
    "status",
    "name",
    "distance_mi",
    "address",
    "website",
    "primary_type",
    "business_status",
    "category_state",
    "place_id",
    "matched_club_id",
    "matched_club_name",
    "deny_reason",
    "deny_google_primary_type",
    "deny_evidence",
]


def _render(results, fmt) -> None:
    """Print classified venues to stdout in the requested format."""
    if fmt == "json":
        print(json.dumps(results, indent=2))
        return
    if fmt == "csv":
        buf = io.StringIO()
        writer = csv.DictWriter(buf, fieldnames=_CSV_FIELDS)
        writer.writeheader()
        writer.writerows(results)
        print(buf.getvalue(), end="")
        return
    if not results:
        print("(no venues found)")
        return
    tag = {"new": "NEW   ", "likely": "likely", "known": "known ", "denied": "denied"}
    for r in results:
        loc = r["address"] or ""
        category = f" [{r['category_state']}]" if r.get("category_state") else ""
        # Flag non-operational venues inline so a human scanning the table sees
        # CLOSED_PERMANENTLY / CLOSED_TEMPORARILY without reading the JSON. An
        # OPERATIONAL (or absent) status is the common case and adds no noise.
        biz = r.get("business_status")
        closed = f" !{biz}" if biz and biz != "OPERATIONAL" else ""
        suffix = ""
        if r["matched_club_name"]:
            suffix = f"  → club #{r['matched_club_id']} {r['matched_club_name']!r}"
        elif r.get("website"):
            suffix = f"  {r['website']}"
        print(
            f"[{tag.get(r['status'], r['status'])}] {r['distance_mi']:>5.1f} mi  "
            f"{r['name']}{category}{closed}{(' — ' + loc) if loc else ''}{suffix}"
        )


if __name__ == "__main__":
    main()
