#!/usr/bin/env python3
"""
Discover comedy venues near a ZIP code via the Google Places API and diff the
results against the clubs already in our database.

Google Places Text Search biases results toward a circle whose radius the API
caps at 50 km (~31 mi). To cover a larger radius this tiles the target disk
with a grid of overlapping search centers, dedupes the hits on place_id, then
keeps only venues whose TRUE great-circle distance from the origin ZIP is
within --radius (the bias is soft, so Google returns some venues from beyond
the ring). Each hit is then classified against the clubs table:

    known   place_id already stored on clubs.google_place_id
    likely  name matches an existing club within ~2 mi (probable same venue,
            place_id just not linked yet)
    new     no match — a candidate venue we don't track

Usage:
    cd apps/scraper && python bin/discover-nearby --zip 44622
    cd apps/scraper && python bin/discover-nearby --zip 44622 --radius 100
    cd apps/scraper && python bin/discover-nearby --zip 10001 --query "comedy" --new-only
    cd apps/scraper && python bin/discover-nearby --zip 44622 --format json
    make discover-nearby ZIP=44622 RADIUS=100

Needs GOOGLE_PLACES_API_KEY in apps/scraper/.env (each tile page is one
billable Text Search request, drawn from GOOGLE_PLACES_DAILY_LIMIT). Reads
DATABASE_URL from apps/scraper/.env (same fallback as bin/query).
"""

import argparse
import csv
import io
import json
import math
import os
import re
import sys
from pathlib import Path
from urllib.parse import quote

SCRIPT_DIR = Path(__file__).resolve().parent
SCRAPER_ROOT = SCRIPT_DIR.parent
ENV_FILE = SCRAPER_ROOT / ".env"

try:
    from dotenv import load_dotenv
except ImportError:
    print("Error: python-dotenv is not installed. Run: pip install python-dotenv", file=sys.stderr)
    sys.exit(1)

if not ENV_FILE.exists():
    print(f"Warning: .env not found at {ENV_FILE} — falling back to environment variables", file=sys.stderr)

load_dotenv(ENV_FILE)

# pgeocode (via ZipCodeDistance) downloads its dataset over HTTPS with urllib,
# which on macOS often can't find a system CA bundle and fails verification.
# Point it at certifi's bundle (a requests dependency, always present) unless
# the environment already specifies one.
if not os.environ.get("SSL_CERT_FILE"):
    try:
        import certifi

        os.environ["SSL_CERT_FILE"] = certifi.where()
        os.environ.setdefault("REQUESTS_CA_BUNDLE", certifi.where())
    except ImportError:
        pass

# src/ for the ``laughtrack`` package; the scraper root for the top-level
# ``sql`` package that the clients/entities import chain pulls in (it's
# normally resolved off the cwd, which a script file doesn't put on the path).
sys.path.insert(0, str(SCRAPER_ROOT))
sys.path.insert(0, str(SCRAPER_ROOT / "src"))

from laughtrack.core.clients.google.places import GooglePlacesClient  # noqa: E402
from laughtrack.core.services.notification.geo import (  # noqa: E402
    ZipCodeDistance,
    _haversine_miles,
)

_MILES_PER_LAT_DEGREE = 69.0


def _resolve_database_url() -> str:
    """Resolve DATABASE_URL or compose one from the host-family vars."""
    url = os.environ.get("DATABASE_URL")
    if url:
        return url

    host = os.environ.get("DATABASE_HOST")
    user = os.environ.get("DATABASE_USER")
    password = os.environ.get("DATABASE_PASSWORD")
    name = os.environ.get("DATABASE_NAME")
    port = os.environ.get("DATABASE_PORT", "5432")

    missing = [
        var
        for var, val in (
            ("DATABASE_HOST", host),
            ("DATABASE_USER", user),
            ("DATABASE_PASSWORD", password),
            ("DATABASE_NAME", name),
        )
        if not val
    ]
    if missing:
        print(
            "Error: DATABASE_URL not set, and could not compose one from "
            f"DATABASE_HOST/USER/PASSWORD/NAME/PORT — missing: {', '.join(missing)}. "
            f"Set DATABASE_URL or the host-family vars in {ENV_FILE}",
            file=sys.stderr,
        )
        sys.exit(1)

    return f"postgresql://{quote(user, safe='')}:{quote(password, safe='')}" f"@{host}:{port}/{name}?sslmode=require"


def _normalize_name(name: str) -> str:
    """Lowercase and strip to alphanumerics for tolerant club-name matching."""
    return re.sub(r"[^a-z0-9]", "", (name or "").lower())


def _tile_centers(lat, lng, radius_miles, spacing_miles):
    """Grid of search centers covering the radius-mile disk around (lat, lng).

    Steps a square grid by ``spacing_miles`` across the disk's bounding box and
    keeps only centers within ``radius_miles`` of the origin (plus the origin
    itself). Longitude degrees are scaled by cos(lat) so spacing stays ~uniform
    in miles. Overlapping coverage is intentional — dedup on place_id collapses
    the repeats while the overlap reduces gaps between tiles.
    """
    lat_step = spacing_miles / _MILES_PER_LAT_DEGREE
    cos_lat = math.cos(math.radians(lat)) or 1e-9
    lng_step = spacing_miles / (_MILES_PER_LAT_DEGREE * cos_lat)

    steps = int(math.ceil(radius_miles / spacing_miles))
    centers = [(lat, lng)]
    seen = {(0, 0)}
    for i in range(-steps, steps + 1):
        for j in range(-steps, steps + 1):
            if (i, j) in seen:
                continue
            seen.add((i, j))
            c_lat = lat + i * lat_step
            c_lng = lng + j * lng_step
            if _haversine_miles(lat, lng, c_lat, c_lng) <= radius_miles:
                centers.append((c_lat, c_lng))
    return centers


def _load_existing_clubs(dsn):
    """Return existing clubs as (by_place_id dict, list of name/coord rows)."""
    import psycopg2  # noqa: F401

    from laughtrack.foundation.db_util import connect_with_retry

    conn = connect_with_retry(dsn)
    try:
        conn.autocommit = True
        with conn.cursor() as cur:
            cur.execute("SELECT id, name, latitude, longitude, google_place_id FROM clubs")
            rows = cur.fetchall()
    finally:
        conn.close()

    by_place_id = {}
    name_rows = []
    for club_id, name, lat, lng, place_id in rows:
        if place_id:
            by_place_id[place_id] = (club_id, name)
        name_rows.append(
            (
                club_id,
                name,
                _normalize_name(name),
                float(lat) if lat is not None else None,
                float(lng) if lng is not None else None,
            )
        )
    return by_place_id, name_rows


def _classify(venue, origin, by_place_id, name_rows, name_match_miles):
    """Tag a discovered venue as known / likely / new against existing clubs."""
    if venue.place_id in by_place_id:
        club_id, club_name = by_place_id[venue.place_id]
        return "known", club_id, club_name

    target = _normalize_name(venue.name)
    if target:
        for club_id, club_name, norm, lat, lng in name_rows:
            if norm != target:
                continue
            # Same normalized name — confirm proximity when we have coords so
            # a chain like "Funny Bone" in two cities isn't collapsed to one.
            if lat is None or lng is None:
                return "likely", club_id, club_name
            if _haversine_miles(venue.lat, venue.lng, lat, lng) <= name_match_miles:
                return "likely", club_id, club_name
    return "new", None, None


def main() -> None:
    parser = argparse.ArgumentParser(description="Discover comedy venues near a ZIP via Google Places.")
    parser.add_argument("--zip", required=True, help="Origin US ZIP code, e.g. 44622")
    parser.add_argument("--radius", type=float, default=100.0, help="Search radius in miles (default 100)")
    parser.add_argument("--query", default="comedy club", help='Text query (default "comedy club")')
    parser.add_argument(
        "--spacing",
        type=float,
        default=40.0,
        help="Miles between search tile centers (default 40; smaller = more API calls, fewer gaps)",
    )
    parser.add_argument(
        "--max-pages",
        type=int,
        default=3,
        help="Result pages per tile, 20 each, 3 = 60 max (default 3)",
    )
    parser.add_argument(
        "--name-match-miles",
        type=float,
        default=2.0,
        help="Proximity for same-name 'likely known' match (default 2)",
    )
    parser.add_argument("--new-only", action="store_true", help="Show only net-new venues")
    parser.add_argument("--format", choices=["table", "json", "csv"], default="table", help="Output format")
    parser.add_argument("--limit", type=int, help="Cap rows in output")
    args = parser.parse_args()

    client = GooglePlacesClient()
    if not client.is_configured:
        print(
            "Error: GOOGLE_PLACES_API_KEY is not set in " f"{ENV_FILE} — cannot run Places discovery.",
            file=sys.stderr,
        )
        sys.exit(1)

    origin = ZipCodeDistance().get_coords(args.zip)
    if origin is None:
        print(f"Error: could not resolve ZIP {args.zip!r} to coordinates.", file=sys.stderr)
        sys.exit(1)
    o_lat, o_lng = origin

    centers = _tile_centers(o_lat, o_lng, args.radius, args.spacing)
    # Per-tile bias radius: half the spacing covers the gap to the next center,
    # clamped to a 5 mi floor so tiny --spacing values still search a real area.
    tile_radius = max(args.spacing / 2.0, 5.0)
    print(
        f"Searching {len(centers)} tile(s) for {args.query!r} within "
        f"{args.radius:g} mi of {args.zip} ({o_lat:.4f},{o_lng:.4f})…",
        file=sys.stderr,
    )

    deduped = {}
    for c_lat, c_lng in centers:
        for venue in client.search_nearby(args.query, c_lat, c_lng, tile_radius, max_pages=args.max_pages):
            deduped[venue.place_id] = venue

    dsn = _resolve_database_url()
    by_place_id, name_rows = _load_existing_clubs(dsn)

    results = []
    for venue in deduped.values():
        dist = _haversine_miles(o_lat, o_lng, venue.lat, venue.lng)
        if dist > args.radius:
            continue
        status, club_id, club_name = _classify(venue, origin, by_place_id, name_rows, args.name_match_miles)
        if args.new_only and status != "new":
            continue
        results.append(
            {
                "status": status,
                "name": venue.name,
                "distance_mi": round(dist, 1),
                "address": venue.address,
                "website": venue.website,
                "primary_type": venue.primary_type,
                "place_id": venue.place_id,
                "matched_club_id": club_id,
                "matched_club_name": club_name,
            }
        )

    results.sort(key=lambda r: (r["distance_mi"], r["name"].lower()))
    if args.limit is not None:
        results = results[: args.limit]

    counts = {"new": 0, "likely": 0, "known": 0}
    for r in results:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    print(
        f"Places API calls used this run: {client.calls_made} " f"({client.calls_remaining} remaining today)",
        file=sys.stderr,
    )
    print(
        f"{len(results)} venue(s): " f"{counts['new']} new, {counts['likely']} likely-known, {counts['known']} known",
        file=sys.stderr,
    )

    _render(results, args.format)


_CSV_FIELDS = [
    "status",
    "name",
    "distance_mi",
    "address",
    "website",
    "primary_type",
    "place_id",
    "matched_club_id",
    "matched_club_name",
]


def _render(results, fmt) -> None:
    """Print classified venues to stdout in the requested format."""
    if fmt == "json":
        print(json.dumps(results, indent=2))
        return
    if fmt == "csv":
        buf = io.StringIO()
        writer = csv.DictWriter(buf, fieldnames=_CSV_FIELDS)
        writer.writeheader()
        writer.writerows(results)
        print(buf.getvalue(), end="")
        return
    if not results:
        print("(no venues found)")
        return
    tag = {"new": "NEW   ", "likely": "likely", "known": "known "}
    for r in results:
        loc = r["address"] or ""
        suffix = ""
        if r["matched_club_name"]:
            suffix = f"  → club #{r['matched_club_id']} {r['matched_club_name']!r}"
        elif r.get("website"):
            suffix = f"  {r['website']}"
        print(
            f"[{tag.get(r['status'], r['status'])}] {r['distance_mi']:>5.1f} mi  "
            f"{r['name']}{(' — ' + loc) if loc else ''}{suffix}"
        )


if __name__ == "__main__":
    main()
