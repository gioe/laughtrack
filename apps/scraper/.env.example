# Example .env file for email configuration
# Copy this to .env and replace with your actual values
#
# IMPORTANT — quoting rule for values containing a literal '$':
# This file is sourced by bin/dev (and other shell entry points), so any
# unquoted '$' triggers shell parameter expansion at source time and the
# value is SILENTLY TRUNCATED — no error, no warning. Always wrap such
# values in SINGLE quotes (double quotes still expand '$'). Example:
#   WRONG:  PODCASTINDEX_API_SECRET=abc$m1nXyz    # sourced as "abc"
#   RIGHT:  PODCASTINDEX_API_SECRET='abc$m1nXyz'  # sourced as "abc$m1nXyz"
# Values that contain no '$' do not need quoting.

# SMTP Configuration (required for sending emails)
# For Gmail: smtp.gmail.com, port 587, use app password not regular password
# For Outlook: smtp-mail.outlook.com, port 587
# For Yahoo: smtp.mail.yahoo.com, port 587
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=admin@laugh-track.com
EMAIL_SMTP_PASSWORD=pugb piud dqex lmtx
EMAIL_SMTP_USE_TLS=true

# Email From Address (optional - has hardcoded fallback)
EMAIL_FROM_EMAIL=admin@laugh-track.com
EMAIL_FROM_NAME=Laughtrack Scraper

# Alert recipients for scraping reports (read by ConfigManager as ALERT_RECIPIENTS)
# REPLACE admin@laugh-track.com WITH YOUR ACTUAL EMAIL
ALERT_RECIPIENTS=admin@laugh-track.com

# For multiple recipients, separate with commas:
# ALERT_RECIPIENTS=admin@laugh-track.com,dev@yourcompany.com,team@yourcompany.com

# Note: If no SMTP credentials are provided, the system will use a mock email provider
# that logs email details instead of actually sending them.

# Scraping Concurrency
# Maximum number of clubs scraped simultaneously (default: 5)
# MAX_CONCURRENT_CLUBS=5

# Seconds serialized_db_call waits on the cross-thread DB write RLock before
# raising LockHeldError (default: 30). Drives the cascade fail-fast bound in
# apps/scraper/src/laughtrack/foundation/infrastructure/database/write_lock.py.
# Raise if a legitimate large-batch upsert is being tripped; lower to fail
# faster when a contender pile-up shows up in nightly Discord summaries.
# LOCK_HOLD_TIMEOUT=30

# Retry backoff (seconds) for a single LockHeldError on the Eventbrite
# organizer-mode per-venue upsert (default: 2.0). When the cascade fail-fast
# above raises LockHeldError, _upsert_one retries once after sleeping this
# long — the stuck prior writer's outermost timeout typically clears within
# seconds, so a brief backoff recovers the venue's events instead of
# dropping them silently (TASK-2626). Falls back to the default on a
# malformed value (e.g. "2s" or empty string).
# EB_LOCK_TIMEOUT_RETRY_BACKOFF_SECS=2.0

# SeatEngine API (optional - only needed if scraping SeatEngine-powered clubs)
# Run: bash apps/scraper/scripts/fetch_seatengine_token.sh  (or /fetch-seatengine-token)
# SEATENGINE_AUTH_TOKEN=

# Discord webhook for scraping success-rate alerts (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Bunny CDN Storage (optional - only needed for automated image uploads)
# BUNNYCDN_STORAGE_PASSWORD=your-storage-zone-password
# BUNNYCDN_STORAGE_ZONE=your-storage-zone-name
# BUNNYCDN_STORAGE_REGION=la

# Bunny ACCOUNT API key (optional - only needed when replacing existing CDN
# images). Replacing a file in Edge Storage does NOT purge the pull-zone
# cache; the old bytes are served for up to 30 days unless purged.
# BUNNYCDN_STORAGE_PASSWORD cannot purge - it is zone-scoped and gets 401
# from api.bunny.net/purge; purging needs this account-level key
# (Bunny dashboard -> Account -> API). When unset, uploads still succeed
# and the purge step is skipped silently. See TASK-2813/TASK-2816.
# BUNNY_API_KEY=your-account-api-key

# Residential proxy for bot-blocked scrapers (optional, but required for
# scrapers flagged use_residential_proxy=true in the scrapers table — currently
# tixr, ticketweb, comedy_mothership, comedy_clubhouse, palm_beach_improv).
# Format: http://USER:PASS@HOST:PORT  (Decodo: gate.decodo.com:10001;
# pin egress country with the username modifier, e.g. user-XYZ-country-us).
# Unset = direct egress for everyone (no error, just degraded).
# RESIDENTIAL_PROXY_URL=http://user-XYZ-country-us:PASSWORD@gate.decodo.com:10001

# Capsolver API key for DataDome interactive-CAPTCHA solving (optional,
# required to recover the 16 etix.com venues blocked since 2026-04-16 and
# any tixr venue serving DataDome challenges — see TASK-1658 / TASK-1647).
# Without this key the Playwright browser still detects DataDome iframes
# but logs a warning and returns the challenge HTML unchanged, so all
# non-DataDome scrapers are unaffected.
# Get a key at https://capsolver.com (DataDome solves cost ~$2/1000;
# expected scraper spend at current volume is ~$1.50/month).
# CAPSOLVER_API_KEY=your-capsolver-api-key

# ---------------------------------------------------------------------------
# Push notifications (comedian-arrival alerts)
# ---------------------------------------------------------------------------
# Consumed by the `notify-comedian-arrivals` CLI (core/services/notification).
# iOS delivery uses APNs; Android delivery uses FCM HTTP v1. Each platform is
# independent — if one set of credentials is missing, that platform's tokens
# raise per-token in the send loop (logged as push_errors) while the other
# platform still delivers. In CI these are wired as GitHub Actions secrets on
# the notify step in .github/workflows/scraper-schedule.yml.

# Apple Push Notification service (iOS). Token-based auth (.p8 key):
#   APNS_TEAM_ID      — Apple Developer team id
#   APNS_KEY_ID       — the key id of the .p8 auth key
#   APNS_PRIVATE_KEY  — the full .p8 PEM. Multi-line: keep the BEGIN/END lines.
#                       MUST be single-quoted (PEM is harmless re: '$', but a
#                       service-account JSON below is not — see the quoting rule
#                       at the top of this file). Alternatively set
#                       APNS_PRIVATE_KEY_PATH to a file path instead.
#   APNS_BUNDLE_ID    — the app bundle id (apns-topic)
#   APNS_USE_SANDBOX  — optional; "true" routes to the APNs sandbox host
#                       (default false = production).
# APNS_TEAM_ID=your-10-char-team-id
# APNS_KEY_ID=your-10-char-key-id
# APNS_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'
# APNS_BUNDLE_ID=app.laughtrack.ios
# APNS_USE_SANDBOX=false

# Firebase Cloud Messaging (Android), HTTP v1. Provide the service-account
# credential one of three ways (first found wins):
#   FCM_SERVICE_ACCOUNT_JSON  — the full service-account JSON, inline. Wrap in
#                               SINGLE quotes (the JSON contains no '$' today,
#                               but single-quoting is the safe default per the
#                               quoting rule above; the embedded private_key
#                               keeps its \n escapes).
#   FCM_SERVICE_ACCOUNT_PATH  — path to the service-account JSON file, OR
#   GOOGLE_APPLICATION_CREDENTIALS — the standard Google SDK path var.
#   FCM_PROJECT_ID            — Firebase project id. Optional when the JSON
#                               already carries project_id; required otherwise.
# Create the service account in the Firebase project with the
# "Firebase Cloud Messaging API Admin" (cloud-messaging) role and download a
# JSON key. See TASK-3289.
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...", ...}'
# FCM_SERVICE_ACCOUNT_PATH=/absolute/path/to/fcm-service-account.json
# FCM_PROJECT_ID=your-firebase-project-id
