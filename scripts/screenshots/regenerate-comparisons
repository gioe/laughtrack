#!/usr/bin/env bash
# Regenerate the complete mobile screenshot comparison matrix.
#
# This command is capture-only. It intentionally invokes only the native
# `screenshots` lanes; it never invokes an upload, release, or metadata lane.

set -euo pipefail

export FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT="${FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT:-30}"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/../.." && pwd)"
default_output_root="$repo_root/apps/screenshot-comparisons/$(date +%Y-%m-%d)-current-catalog"
output_root="$default_output_root"
open_sheets=true
force_fresh=false
audit_mode="current-main"
preflight_only=false

usage() {
  cat <<'EOF'
Usage: scripts/screenshots/regenerate-comparisons [options]

Capture all catalog scenarios for iOS phone/iPad and Android phone/7-inch/
10-inch, persist validated manifests, generate 17 cross-platform scenario
sheets, and open them. This command never uploads screenshots to either store.

Options:
  --output-root PATH  Destination directory (default: dated comparison folder)
  --no-open           Generate contact sheets without opening them
  --force-fresh       Bypass all validated native profile caches
  --audit-mode MODE   Checkout policy: current-main (default) or explicit-checkout
  --preflight-only    Validate and record checkout provenance, then exit
  -h, --help          Show this help
EOF
}

fail() {
  echo "error: $*" >&2
  exit 1
}

while (($#)); do
  case "$1" in
  --output-root)
    (($# >= 2)) || fail "--output-root requires a path"
    output_root="$2"
    shift 2
    ;;
  --no-open)
    open_sheets=false
    shift
    ;;
  --force-fresh)
    force_fresh=true
    shift
    ;;
  --audit-mode)
    (($# >= 2)) || fail "--audit-mode requires a value"
    audit_mode="$2"
    shift 2
    ;;
  --preflight-only)
    preflight_only=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    fail "unknown option: $1"
    ;;
  esac
done

case "$audit_mode" in
current-main | explicit-checkout) ;;
*) fail "--audit-mode must be current-main or explicit-checkout" ;;
esac

if [[ "$output_root" != /* ]]; then
  output_root="$repo_root/$output_root"
fi

command -v git >/dev/null || fail "git is required"
command -v python3 >/dev/null || fail "python3 is required"

inspect_checkout() {
  revision="$(git -C "$repo_root" rev-parse HEAD)" ||
    fail "$repo_root is not a Git checkout"
  branch="$(git -C "$repo_root" symbolic-ref --quiet --short HEAD || true)"
  detached=false
  if [[ -z "$branch" ]]; then
    detached=true
  fi
  dirty=false
  if [[ -n "$(git -C "$repo_root" status --porcelain --untracked-files=all)" ]]; then
    dirty=true
  fi
  checkout_state_sha256="$(
    python3 - "$repo_root" <<'PY'
import hashlib
import os
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1])
digest = hashlib.sha256()
for args in (
    ("status", "--porcelain=v1", "-z", "--untracked-files=all"),
    ("diff", "--binary", "HEAD"),
    ("diff", "--cached", "--binary", "HEAD"),
):
    digest.update(
        subprocess.run(
            ["git", "-C", str(root), *args],
            check=True,
            capture_output=True,
        ).stdout
    )
untracked = subprocess.run(
    ["git", "-C", str(root), "ls-files", "--others", "--exclude-standard", "-z"],
    check=True,
    capture_output=True,
).stdout.split(b"\0")
for relative_bytes in sorted(path for path in untracked if path):
    relative = os.fsdecode(relative_bytes)
    path = root / relative
    digest.update(relative_bytes)
    digest.update(b"\0")
    if path.is_symlink():
        digest.update(os.fsencode(os.readlink(path)))
    else:
        digest.update(path.read_bytes())
print(digest.hexdigest())
PY
  )"

  origin_main_revision=""
  ahead_by=0
  behind_by=0
  relationship="unavailable"
  if git -C "$repo_root" show-ref --verify --quiet refs/remotes/origin/main; then
    origin_main_revision="$(git -C "$repo_root" rev-parse origin/main)"
    read -r ahead_by behind_by < <(
      git -C "$repo_root" rev-list --left-right --count HEAD...origin/main
    )
    if ((ahead_by == 0 && behind_by == 0)); then
      relationship="exact"
    elif ((ahead_by > 0 && behind_by == 0)); then
      relationship="ahead"
    elif ((ahead_by == 0 && behind_by > 0)); then
      relationship="behind"
    else
      relationship="diverged"
    fi
  fi
}

origin_main_refreshed=false
if [[ "$audit_mode" == "current-main" ]]; then
  echo "Refreshing origin/main for a current-main screenshot audit..."
  if ! git -C "$repo_root" fetch --quiet origin \
    +refs/heads/main:refs/remotes/origin/main; then
    fail "could not refresh origin/main; retry with network access, or use --audit-mode explicit-checkout for a clearly labeled checkout audit"
  fi
  origin_main_refreshed=true
fi

inspect_checkout
branch_label="${branch:-detached}"
if [[ "$audit_mode" == "current-main" ]]; then
  audit_label="CURRENT MAIN"
else
  audit_label="EXPLICIT CHECKOUT (not current-main certified)"
fi

echo "Screenshot audit checkout preflight:"
echo "  audit: $audit_label"
echo "  revision: $revision"
echo "  branch: $branch_label"
echo "  detached: $detached"
echo "  dirty: $dirty"
echo "  origin/main: ${origin_main_revision:-unavailable}"
echo "  relationship: $relationship (ahead $ahead_by, behind $behind_by)"

if [[ "$audit_mode" == "current-main" ]]; then
  if [[ "$dirty" == true ]]; then
    fail "current-main audits require a clean checkout; commit/stash changes or create a clean worktree at origin/main. Use --audit-mode explicit-checkout only when intentionally auditing local changes"
  fi
  if [[ "$relationship" != "exact" ]]; then
    fail "current-main audits require HEAD to equal refreshed origin/main (found $relationship: ahead $ahead_by, behind $behind_by); create a clean worktree at origin/main, or use --audit-mode explicit-checkout for an intentional feature-branch audit"
  fi
fi

mkdir -p "$output_root"
checkout_provenance="$output_root/checkout-provenance.json"
captured_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
python3 - "$checkout_provenance" "$audit_mode" "$audit_label" "$captured_at" \
  "$repo_root" "$revision" "$branch" "$detached" "$dirty" \
  "$origin_main_revision" "$origin_main_refreshed" "$ahead_by" "$behind_by" \
  "$relationship" "$checkout_state_sha256" <<'PY'
import json
import sys
from pathlib import Path

(
    destination,
    audit_mode,
    audit_label,
    captured_at,
    repo_root,
    revision,
    branch,
    detached,
    dirty,
    origin_main_revision,
    origin_main_refreshed,
    ahead_by,
    behind_by,
    relationship,
    checkout_state_sha256,
) = sys.argv[1:]
value = {
    "schema_version": 1,
    "status": "preflight_passed",
    "audit_mode": audit_mode,
    "audit_label": audit_label,
    "captured_at": captured_at,
    "repository_root": repo_root,
    "revision": revision,
    "branch": None if detached == "true" else branch,
    "detached": detached == "true",
    "dirty": dirty == "true",
    "origin_main_revision": origin_main_revision or None,
    "origin_main_refreshed": origin_main_refreshed == "true",
    "ahead_by": int(ahead_by),
    "behind_by": int(behind_by),
    "relationship": relationship,
    "checkout_state_sha256": checkout_state_sha256,
}
Path(destination).write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
PY
echo "  provenance: $checkout_provenance"

if [[ "$preflight_only" == true ]]; then
  echo "Checkout preflight complete."
  exit 0
fi

initial_revision="$revision"
initial_branch="$branch"
initial_dirty="$dirty"
initial_checkout_state_sha256="$checkout_state_sha256"

command -v xcrun >/dev/null || fail "xcrun is required"
command -v adb >/dev/null || fail "adb is required"
command -v magick >/dev/null || fail "ImageMagick's magick command is required"
[[ -x "$repo_root/ios/bin/lane" ]] || fail "ios/bin/lane is not executable"
[[ -x "$repo_root/android/bin/lane" ]] || fail "android/bin/lane is not executable"

ios_run="$output_root/runs/ios"
android_run="$output_root/runs/android"
mkdir -p "$output_root/runs"

echo "Pruning orphaned iOS screenshot DerivedData caches..."
prune_args=(prune-derived-data --repo-root "$repo_root")
if [[ -n "${LAUGHTRACK_SCREENSHOT_DERIVED_DATA_PATH:-}" ]]; then
  prune_args+=(--preserve-path "$LAUGHTRACK_SCREENSHOT_DERIVED_DATA_PATH")
fi
python3 "$repo_root/scripts/screenshots/cache.py" "${prune_args[@]}"

echo "Capturing iOS comparison matrix..."
ios_lane_args=(screenshots "run_root:$ios_run" comparison_only:true)
android_lane_args=(screenshots "run_root:$android_run" comparison_only:true)
if [[ "$force_fresh" == true ]]; then
  ios_lane_args+=(force_fresh:true)
  android_lane_args+=(force_fresh:true)
fi
"$repo_root/ios/bin/lane" "${ios_lane_args[@]}"

echo "Capturing Android comparison matrix..."
"$repo_root/android/bin/lane" "${android_lane_args[@]}"

echo "Validating persistent manifests..."
python3 "$repo_root/scripts/screenshots/manifest.py" validate-run \
  "$ios_run/manifest.json" \
  --catalog "$repo_root/screenshots/catalog.json" \
  --repo-root "$ios_run" \
  --require-complete
python3 "$repo_root/scripts/screenshots/manifest.py" validate-run \
  "$android_run/manifest.json" \
  --catalog "$repo_root/screenshots/catalog.json" \
  --repo-root "$android_run" \
  --require-complete

echo "Generating cross-platform scenario sheets and audit metadata..."
python3 "$repo_root/scripts/screenshots/comparison.py" \
  --ios-manifest "$ios_run/manifest.json" \
  --android-manifest "$android_run/manifest.json" \
  --catalog "$repo_root/screenshots/catalog.json" \
  --baseline "$repo_root/apps/screenshot-comparisons/reviewed-baseline.json" \
  --sheet-dir "$output_root/scenario-sheets" \
  > "$output_root/comparison.json"

sheets=("$output_root/scenario-sheets"/*.png)

if [[ "$open_sheets" == true ]]; then
  if command -v open >/dev/null; then
    open "${sheets[@]}"
  else
    echo "warning: 'open' is unavailable; contact sheets were generated but not opened" >&2
  fi
fi

inspect_checkout
if [[ "$revision" != "$initial_revision" ||
  "$branch" != "$initial_branch" ||
  "$dirty" != "$initial_dirty" ||
  "$checkout_state_sha256" != "$initial_checkout_state_sha256" ]]; then
  fail "checkout changed during screenshot capture; discard this audit and rerun from a stable checkout"
fi
completed_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
python3 - "$checkout_provenance" "$completed_at" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
value = json.loads(path.read_text(encoding="utf-8"))
value["status"] = "completed"
value["completed_at"] = sys.argv[2]
value["checkout_unchanged"] = True
path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
PY

echo "Complete comparison matrix: $output_root"
