#!/usr/bin/env bash
# Regenerate the complete mobile screenshot comparison matrix.
#
# This command is capture-only. It intentionally invokes only the native
# `screenshots` lanes; it never invokes an upload, release, or metadata lane.

set -euo pipefail

export FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT="${FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT:-30}"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/../.." && pwd)"
default_output_root="$repo_root/apps/screenshot-comparisons/$(date +%Y-%m-%d)-current-catalog"
output_root="$default_output_root"
open_sheets=true
force_fresh=false

usage() {
  cat <<'EOF'
Usage: scripts/screenshots/regenerate-comparisons [options]

Capture all catalog scenarios for iOS phone/iPad and Android phone/7-inch/
10-inch, persist validated manifests, generate five contact sheets, and open
them. This command never uploads screenshots to either store.

Options:
  --output-root PATH  Destination directory (default: dated comparison folder)
  --no-open           Generate contact sheets without opening them
  --force-fresh       Bypass all validated native profile caches
  -h, --help          Show this help
EOF
}

fail() {
  echo "error: $*" >&2
  exit 1
}

while (($#)); do
  case "$1" in
  --output-root)
    (($# >= 2)) || fail "--output-root requires a path"
    output_root="$2"
    shift 2
    ;;
  --no-open)
    open_sheets=false
    shift
    ;;
  --force-fresh)
    force_fresh=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    fail "unknown option: $1"
    ;;
  esac
done

if [[ "$output_root" != /* ]]; then
  output_root="$repo_root/$output_root"
fi

command -v xcrun >/dev/null || fail "xcrun is required"
command -v adb >/dev/null || fail "adb is required"
command -v magick >/dev/null || fail "ImageMagick's magick command is required"
command -v python3 >/dev/null || fail "python3 is required"
[[ -x "$repo_root/ios/bin/lane" ]] || fail "ios/bin/lane is not executable"
[[ -x "$repo_root/android/bin/lane" ]] || fail "android/bin/lane is not executable"

# A stale local main silently captures an obsolete catalog. Feature branches
# and detached worktrees remain valid because they may intentionally exercise
# changes that have not landed on origin/main yet.
branch="$(git -C "$repo_root" branch --show-current)"
if [[ "$branch" == "main" ]] && git -C "$repo_root" show-ref --verify --quiet refs/remotes/origin/main; then
  if ! git -C "$repo_root" merge-base --is-ancestor origin/main HEAD; then
    fail "local main is behind or diverged from origin/main; update it or run from a current worktree"
  fi
fi

ios_run="$output_root/runs/ios"
android_run="$output_root/runs/android"
mkdir -p "$output_root/runs"

echo "Capturing iOS comparison matrix..."
ios_lane_args=(screenshots "run_root:$ios_run" comparison_only:true)
android_lane_args=(screenshots "run_root:$android_run" comparison_only:true)
if [[ "$force_fresh" == true ]]; then
  ios_lane_args+=(force_fresh:true)
  android_lane_args+=(force_fresh:true)
fi
"$repo_root/ios/bin/lane" "${ios_lane_args[@]}"

echo "Capturing Android comparison matrix..."
"$repo_root/android/bin/lane" "${android_lane_args[@]}"

echo "Validating persistent manifests..."
python3 "$repo_root/scripts/screenshots/manifest.py" validate-run \
  "$ios_run/manifest.json" \
  --catalog "$repo_root/screenshots/catalog.json" \
  --repo-root "$ios_run"
python3 "$repo_root/scripts/screenshots/manifest.py" validate-run \
  "$android_run/manifest.json" \
  --catalog "$repo_root/screenshots/catalog.json" \
  --repo-root "$android_run"

font=""
for candidate in \
  /System/Library/Fonts/Helvetica.ttc \
  /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
  /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf; do
  if [[ -f "$candidate" ]]; then
    font="$candidate"
    break
  fi
done
[[ -n "$font" ]] || fail "no supported contact-sheet font found"

generate_sheet() {
  local profile_dir="$1"
  local geometry="$2"
  local destination="$3"
  local images=("$profile_dir"/*.png)
  ((${#images[@]} > 0)) || fail "no screenshots found in $profile_dir"
  magick montage "${images[@]}" \
    -font "$font" \
    -thumbnail "$geometry" \
    -tile 4x \
    -geometry +16+16 \
    -background '#202124' \
    "$destination"
}

echo "Generating contact sheets..."
generate_sheet "$ios_run/images/ios_phone" 360x800 "$output_root/all-ios-phone.png"
generate_sheet "$ios_run/images/ios_large_tablet" 400x720 "$output_root/all-ios-ipad.png"
generate_sheet "$android_run/images/android_phone" 360x800 "$output_root/all-android-phone.png"
generate_sheet "$android_run/images/android_small_tablet" 400x720 "$output_root/all-android-7-inch.png"
generate_sheet "$android_run/images/android_large_tablet" 400x720 "$output_root/all-android-10-inch.png"

sheets=(
  "$output_root/all-ios-phone.png"
  "$output_root/all-ios-ipad.png"
  "$output_root/all-android-phone.png"
  "$output_root/all-android-7-inch.png"
  "$output_root/all-android-10-inch.png"
)

if [[ "$open_sheets" == true ]]; then
  if command -v open >/dev/null; then
    open "${sheets[@]}"
  else
    echo "warning: 'open' is unavailable; contact sheets were generated but not opened" >&2
  fi
fi

echo "Complete comparison matrix: $output_root"
