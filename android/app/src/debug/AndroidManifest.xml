<?xml version="1.0" encoding="utf-8"?>
<!-- Registers the empty @AndroidEntryPoint host activity used by the
     @HiltAndroidTest Compose UI tests (AppShellTest). It is declared in the
     DEBUG source set (the tested variant) rather than androidTest so it is
     registered under the app-under-test package (…android.debug). The
     instrumentation runs in that process; a HiltTestActivity declared in the
     androidTest APK (…android.debug.test) instead fails to launch with
     "Intent resolved to different process" because the test and app APKs have
     different package IDs/UIDs.

     Uses a framework no-action-bar theme; the host only provides the window and
     Compose themes its content via LaughTrackTheme. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- fastlane screengrab needs these to drive the device during a capture run:
         CHANGE_CONFIGURATION lets it switch the in-app locale for each locale in
         the Screengrabfile, and DISABLE_KEYGUARD keeps the lock screen out of the
         way so frames aren't captured behind the keyguard. Debug-only (this source
         set is never part of a release build). -->
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- MockWebServer serves hermetic API and artwork fixtures on loopback during
         screenshot instrumentation. Release builds retain the platform default. -->
    <application android:usesCleartextTraffic="true">
        <activity
            android:name="app.laughtrack.android.HiltTestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>

</manifest>
