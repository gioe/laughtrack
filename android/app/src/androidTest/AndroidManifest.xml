<?xml version="1.0" encoding="utf-8"?>
<!-- Registers the empty @AndroidEntryPoint host activity used by the
     @HiltAndroidTest Compose UI tests (AppShellTest). Uses a framework
     no-action-bar theme: the test APK has its own resource namespace and cannot
     resolve the main app's @style/Theme.LaughTrack, and the host only provides
     the window anyway — Compose themes its content via LaughTrackTheme. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="app.laughtrack.android.HiltTestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>

</manifest>
