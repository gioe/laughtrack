# Standard Gradle wrapper bootstrap script (canonical, Gradle 8.x).
# Requires gradle/wrapper/gradle-wrapper.jar to be present; generate it once
# with `gradle wrapper` or by opening the project in Android Studio.

set -e

APP_HOME=$(cd "$(dirname "$0")" && pwd)
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the Java command to use.
if [ -n "$JAVA_HOME" ]; then
    JAVACMD=$JAVA_HOME/bin/java
else
    JAVACMD=java
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1; then
    echo "ERROR: JAVA_HOME is not set and no 'java' command could be found." >&2
    echo "Install a JDK (17+) and set JAVA_HOME." >&2
    exit 1
fi

if [ ! -f "$CLASSPATH" ]; then
    echo "ERROR: $CLASSPATH not found." >&2
    echo "Generate the wrapper jar once with 'gradle wrapper' or open the project in Android Studio." >&2
    exit 1
fi

exec "$JAVACMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
