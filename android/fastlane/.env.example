# LaughTrack Android — fastlane environment template.
#
# Copy this file to `.env` in this same directory and fill in real values.
# `.env` is gitignored; `.env.example` is committed as the template. Fastlane
# auto-loads `android/fastlane/.env` before running any lane.
#
# In CI none of this is needed: .github/workflows/android-release.yml injects the
# same values from GitHub Actions secrets (PLAY_SERVICE_ACCOUNT_JSON,
# ANDROID_UPLOAD_KEYSTORE_B64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS).
# These vars are for running a release lane from a local machine.

# --- Play service account (used by `supply` / upload_to_play_store) ----------
# Absolute or android/-relative path to the Play service-account JSON downloaded
# from Google Cloud. The Appfile falls back to ./play-service-account.json if
# this is unset. Never commit the JSON (see android/.gitignore).
SUPPLY_JSON_KEY=play-service-account.json

# --- Release signing (read by app/build.gradle.kts) --------------------------
# Path to the upload keystore (.jks/.p12). Alternatively drop an
# app/keystore.properties file (storeFile/storePassword/keyAlias/keyPassword)
# and these env vars are ignored.
ANDROID_KEYSTORE_PATH=/absolute/path/to/upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEY_ALIAS=upload
# Optional — defaults to ANDROID_KEYSTORE_PASSWORD when the keystore uses a
# single password for both the store and the key.
ANDROID_KEY_PASSWORD=""
