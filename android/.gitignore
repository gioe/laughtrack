# Firebase config is injected per-environment; keep the real file out of VCS.
google-services.json
# Secrets / signing material — never commit (parity with iOS: keys go in CI secrets)
keystore.properties
*.jks
play-service-account.json

# Fastlane — secrets + generated artifacts (mirrors root .gitignore's ios/fastlane
# block). fastlane auto-loads fastlane/.env for the env vars read by the Fastfile.
fastlane/.env
fastlane/.env.*
!fastlane/.env.example
fastlane/report.xml
fastlane/Preview.html
fastlane/README.md
fastlane/test_output/
