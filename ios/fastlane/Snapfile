# Canonical iOS capture profiles: the 6.9" iPhone covers all mandatory App
# Store iPhone sizes, and the 13" iPad is the large-tablet comparison profile.
devices([
  "iPhone 16 Pro Max",
  "iPad Pro 13-inch (M4)"
])

languages(["en-US"])

# Don't pin ios_version: snapshot normalizes "18.3.1" → "18.3" before passing
# it to xcodebuild (which strictly requires the patch version "18.3.1" the
# installed runtime reports). Omitting it lets snapshot leave OS= off the
# destination so xcodebuild auto-selects the only installed iOS 18.x runtime.
# The CI test lane (Fastfile :test) pins TEST_IOS_VERSION = "18.3.1" through
# run_tests directly, so it isn't affected by this snapshot quirk.

scheme("LaughTrack")

# The shipping app intentionally remains iPhone-only. Build the screenshot
# matrix as a universal app so the iPad profile renders native tablet geometry
# instead of iPhone compatibility mode without changing release configuration.
xcargs("TARGETED_DEVICE_FAMILY=1,2")

# Snapshot otherwise creates and deletes a temporary DerivedData directory on
# every run. Keep an isolated cache per worktree so repeated captures can reuse
# build products without concurrent worktrees sharing incompatible artifacts.
require "digest"
screenshot_worktree = File.expand_path("../..", __dir__)
screenshot_worktree_hash = Digest::SHA256.hexdigest(screenshot_worktree)[0, 12]
derived_data_path(
  ENV.fetch(
    "LAUGHTRACK_SCREENSHOT_DERIVED_DATA_PATH",
    File.join(Dir.home, "Library", "Developer", "Xcode", "DerivedData", "LaughTrack-screenshots-wt-#{screenshot_worktree_hash}"),
  ),
)

# Package.resolved remains authoritative during this test-without-building phase.
# The Fastfile's preceding build-for-testing initializes a cold package cache, so
# snapshot skips redundant resolution and remote update checks here.
skip_package_dependencies_resolution(true)
disable_package_automatic_updates(true)
skip_package_repository_fetches(true)

output_directory("./fastlane/screenshots")

clear_previous_screenshots(true)

override_status_bar(true)

# Tier 2 work will create this UI test target. Until then this lane will fail
# at the xcodebuild step with "no matching test cases."
only_testing(["LaughTrackUITests/AppStoreScreenshotTests/testGenerateAllScreenshots"])

launch_arguments(["-UITestMockMode"])

stop_after_first_error(true)

# The Fastfile clears LaughTrack's installed app state before snapshot launches.
erase_simulator(false)

# Run devices sequentially to avoid resource contention
concurrent_simulators(false)

# Increase number of retries
number_of_retries(1)
