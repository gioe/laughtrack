# LaughTrack — fastlane environment template.
#
# Copy this file to `.env` in this same directory and fill in real values.
# `.env` is gitignored; `.env.example` is committed as the template.
# Fastlane auto-loads `ios/fastlane/.env` before running any lane, so the
# `ENV.fetch(...)` calls in Fastfile (load_asc_api_key, etc.) resolve.

# App Store Connect API key — used by every lane that talks to ASC
# (upload_metadata, upload_testflight, beta, release, submit_review).
# Create one in App Store Connect → Users and Access → Keys.
# Required role: at minimum "App Manager" for the LaughTrack app.
APP_STORE_CONNECT_API_KEY_ID=AAAAAAAAAA
APP_STORE_CONNECT_API_ISSUER_ID=00000000-0000-0000-0000-000000000000

# The full contents of the .p8 file ASC generated when the key was created
# (App Store Connect only lets you download it once). Paste the entire PEM
# including BEGIN/END lines on one line, with literal `\n` between lines —
# fastlane's dotenv expands `\n` to real newlines when the value is quoted.
# Example:
# APP_STORE_CONNECT_API_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\nMIGTAg…\n-----END PRIVATE KEY-----"
APP_STORE_CONNECT_API_KEY_CONTENT=""
