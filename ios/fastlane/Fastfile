require "digest"
require "fileutils"
require "json"
require "open3"
require "socket"
require "tmpdir"

default_platform(:ios)

APP_IDENTIFIER = "app.laughtrack.ios"
NOTIFICATION_SERVICE_EXTENSION_IDENTIFIER = "app.laughtrack.ios.NotificationServiceExtension"
SCHEME = "LaughTrack"
INFO_PLIST_PATH = "Sources/LaughTrackApp/Info.plist"
PROJECT_YML_PATH = "../project.yml"
IPA_NAME = "LaughTrack.ipa"
TEAM_ID = "4HDNC3V5Q6"
SCREENSHOT_CATALOG_PATH = File.expand_path("../../screenshots/catalog.json", __dir__)
SCREENSHOT_EXPORT_PATH = File.expand_path("../../scripts/screenshots/export.py", __dir__)
SCREENSHOT_CACHE_PATH = File.expand_path("../../scripts/screenshots/cache.py", __dir__)
SCREENSHOT_FIXTURE_SERVER_PATH = File.expand_path("../../scripts/screenshots/fixture_server.py", __dir__)
SCREENSHOT_FIXTURE_PORT = 8765
REPO_ROOT = File.expand_path("../..", __dir__)
SCREENSHOT_WORKTREE_HASH = Digest::SHA256.hexdigest(REPO_ROOT)[0, 12]
SCREENSHOT_DERIVED_DATA_PATH = ENV.fetch(
  "LAUGHTRACK_SCREENSHOT_DERIVED_DATA_PATH",
  File.join(
    Dir.home,
    "Library",
    "Developer",
    "Xcode",
    "DerivedData",
    "LaughTrack-screenshots-wt-#{SCREENSHOT_WORKTREE_HASH}",
  ),
)
SCREENSHOT_PROFILE_CACHE_PATH = ENV.fetch(
  "LAUGHTRACK_SCREENSHOT_CACHE_PATH",
  File.join(REPO_ROOT, "apps", "screenshot-comparisons", ".profile-cache"),
)
IOS_SCREENSHOT_PROFILE_SETTINGS = {
  "ios_phone" => {
    device_name: "iPhone 16 Pro Max",
  },
  "ios_large_tablet" => {
    device_name: "iPad Pro 13-inch (M4)",
  },
}.freeze

def load_ios_screenshot_collection
  catalog = JSON.parse(File.read(SCREENSHOT_CATALOG_PATH))
  scenario_ids = catalog.fetch("scenarios").map { |scenario| scenario.fetch("id") }
  profiles = catalog.fetch("profiles").select { |profile| profile.fetch("platform") == "ios" }
  profile_ids = profiles.map { |profile| profile.fetch("id") }

  if scenario_ids.empty? || scenario_ids.uniq.length != scenario_ids.length
    raise "Screenshot catalog must define unique scenarios"
  end
  unless profile_ids == IOS_SCREENSHOT_PROFILE_SETTINGS.keys
    raise "Screenshot catalog iOS profiles #{profile_ids.inspect} do not match adapter profiles " \
          "#{IOS_SCREENSHOT_PROFILE_SETTINGS.keys.inspect}"
  end

  {
    scenario_ids: scenario_ids.freeze,
    profiles: profiles.map do |profile|
      IOS_SCREENSHOT_PROFILE_SETTINGS.fetch(profile.fetch("id")).merge(
        id: profile.fetch("id"),
      ).freeze
    end.freeze,
  }.freeze
rescue Errno::ENOENT, JSON::ParserError, KeyError => e
  raise "Invalid screenshot catalog at #{SCREENSHOT_CATALOG_PATH}: #{e.message}"
end

IOS_SCREENSHOT_COLLECTION = load_ios_screenshot_collection
CANONICAL_IOS_SCREENSHOT_IDS = IOS_SCREENSHOT_COLLECTION.fetch(:scenario_ids)
IOS_SCREENSHOT_PROFILES = IOS_SCREENSHOT_COLLECTION.fetch(:profiles)

def ios_screenshot_profile_config
  {
    profiles: IOS_SCREENSHOT_PROFILES.to_h do |profile|
      [profile.fetch(:id), profile]
    end,
  }
end

def run_ios_screenshot_cache(*arguments)
  output, error, status = Open3.capture3(
    "python3", SCREENSHOT_CACHE_PATH,
    "--catalog", SCREENSHOT_CATALOG_PATH,
    *arguments,
  )
  detail = error.strip.empty? ? output.strip : error.strip
  UI.user_error!("Screenshot profile cache failed: #{detail}") unless status.success?
  JSON.parse(output)
rescue JSON::ParserError => e
  UI.user_error!("Screenshot profile cache returned invalid JSON: #{e.message}")
end

def plan_ios_screenshot_cache(capture_root, force_fresh:)
  arguments = [
    "plan", "ios",
    "--capture-root", capture_root,
    "--cache-root", SCREENSHOT_PROFILE_CACHE_PATH,
    "--repo-root", REPO_ROOT,
    "--profile-config-json", JSON.generate(ios_screenshot_profile_config),
  ]
  arguments << "--force-fresh" if force_fresh
  run_ios_screenshot_cache(*arguments)
end

def store_ios_screenshot_profile(capture_root, profile_id, expected_key)
  run_ios_screenshot_cache(
    "store-profile", "ios", profile_id,
    "--capture-root", capture_root,
    "--cache-root", SCREENSHOT_PROFILE_CACHE_PATH,
    "--repo-root", REPO_ROOT,
    "--profile-config-json", JSON.generate(ios_screenshot_profile_config),
    "--expected-key", expected_key,
  )
end

def with_screenshot_fixture_server
  log_path = File.join(Dir.tmpdir, "laughtrack-screenshot-fixture.log")
  pid = Process.spawn(
    "python3", SCREENSHOT_FIXTURE_SERVER_PATH, "--port", SCREENSHOT_FIXTURE_PORT.to_s,
    out: log_path, err: [:child, :out],
  )
  ready = false
  100.times do
    if Process.waitpid(pid, Process::WNOHANG)
      UI.user_error!("Screenshot fixture backend exited early:\n#{File.read(log_path)}")
    end
    begin
      TCPSocket.open("127.0.0.1", SCREENSHOT_FIXTURE_PORT, &:close)
      ready = true
      break
    rescue Errno::ECONNREFUSED
      sleep(0.05)
    end
  end
  UI.user_error!("Screenshot fixture backend did not become ready") unless ready
  previous_port = ENV["LAUGHTRACK_SCREENSHOT_FIXTURE_PORT"]
  ENV["LAUGHTRACK_SCREENSHOT_FIXTURE_PORT"] = SCREENSHOT_FIXTURE_PORT.to_s
  yield
ensure
  ENV["LAUGHTRACK_SCREENSHOT_FIXTURE_PORT"] = previous_port if defined?(previous_port)
  if defined?(pid) && pid
    Process.kill("TERM", pid) rescue nil
    Process.wait(pid) rescue nil
  end
end

def validate_ios_screenshot_collection(screenshot_root)
  directory = File.join(screenshot_root, "en-US")
  expected = IOS_SCREENSHOT_PROFILES.flat_map do |profile|
    CANONICAL_IOS_SCREENSHOT_IDS.map do |scenario_id|
      "#{profile.fetch(:device_name)}-#{scenario_id}.png"
    end
  end.sort
  actual = Dir.glob(File.join(directory, "*.png")).map { |path| File.basename(path) }.sort
  return if actual == expected

  UI.user_error!(
    "Expected the canonical #{expected.length}-image iOS collection in #{directory}; " \
    "missing=#{expected - actual}, unexpected=#{actual - expected}",
  )
end

def export_app_store_projection(capture_root, run_root)
  sh(
    "python3", SCREENSHOT_EXPORT_PATH,
    "--catalog", SCREENSHOT_CATALOG_PATH,
    "collect", "ios",
    "--source-root", capture_root,
    "--run-root", run_root,
    "--repo-root", REPO_ROOT,
    "--provenance", File.join(capture_root, ".screenshot-cache-provenance.json"),
  )
  sh(
    "python3", SCREENSHOT_EXPORT_PATH,
    "--catalog", SCREENSHOT_CATALOG_PATH,
    "export", "app-store", File.join(run_root, "manifest.json"),
    "--repo-root", run_root,
    "--output-root", File.expand_path("screenshots", __dir__),
  )
end

# Test simulator pin (TASK-2339). The iOS 26.1 / 26.2 SDK has a regression in
# _UIHostingView's accessibility-tree wiring that fails ~18 tests across 16
# HostedView suites on those runtimes (bisect table in ios/CLAUDE.md under
# "iOS 26 Accessibility-Tree Wiring Regression (TASK-1921)"). The suite passes
# cleanly on iOS 18.x. Pin the test lane to an iOS 18 runtime until Apple ships
# a fix, with a separate non-blocking watcher lane against the latest 26.x
# runtime so a fix shows up in the CI signal.
#
# Pinned to 18.6 (was 18.3.1): the GitHub Actions macOS runner image dropped the
# 18.3.1 simulator runtime, so the old pin failed with "Unable to find a device
# matching the provided destination specifier". 18.5 / 18.6 are what the current
# image ships; iPhone 16 Pro is available on 18.6. Bump this to whatever iOS 18.x
# runtime the runner provides if 18.6 is later removed (`xcodebuild -showdestinations`).
TEST_SIM_NAME = "iPhone 16 Pro"
TEST_IOS_VERSION = "18.6"
TEST_IOS_26_WATCH_VERSION = "26.2"

# Read a project.yml build setting (e.g. "CURRENT_PROJECT_VERSION") by regex.
# project.yml is the source of truth for build/marketing version (TASK-1902) —
# Info.plist embeds $(CURRENT_PROJECT_VERSION) / $(MARKETING_VERSION) and Xcode
# substitutes at build time, so reading the plist returns the unresolved literal.
#
# Scans every occurrence of the key and asserts all targets carry the same value.
# Falling back to the first match would silently grab a framework target's value
# (LaughTrackCore appears before LaughTrack in project.yml) if the values ever
# drifted; raising loudly forces a deliberate fix instead of guessing.
def read_project_yml_setting(key)
  contents = File.read(PROJECT_YML_PATH)
  values = contents.scan(/#{Regexp.escape(key)}:\s*"([^"]*)"/).flatten
  raise "#{key} not found in #{PROJECT_YML_PATH}" if values.empty?
  unique = values.uniq
  if unique.length > 1
    raise "#{key} has divergent values across targets in #{PROJECT_YML_PATH}: #{unique.inspect}. " \
          "Reconcile manually before bumping."
  end
  unique.first
end

# Replace every quoted occurrence of `key: "..."` in project.yml. CURRENT_PROJECT_VERSION
# appears once (LaughTrack target only). MARKETING_VERSION appears on every target —
# they share the same marketing version by design, so replacing all is correct.
def update_project_yml_setting(key, new_value)
  contents = File.read(PROJECT_YML_PATH)
  raise "#{key} not found in #{PROJECT_YML_PATH}" unless contents.match?(/#{Regexp.escape(key)}:\s*"[^"]*"/)

  updated = contents.gsub(/(#{Regexp.escape(key)}:\s*)"[^"]*"/, "\\1\"#{new_value}\"")
  File.write(PROJECT_YML_PATH, updated) if updated != contents
end

# Bump MARKETING_VERSION by semantic component. kind may be :major, :minor, :patch
# (or string equivalents); defaults to :patch. Bumping a higher component zeroes the
# lower ones (2.5.3 + minor → 2.6.0). Three segments required — raise otherwise so a
# legacy two-segment value can't silently produce the wrong semantics.
def bump_marketing_version(current, kind)
  parts = current.to_s.split(".")
  if parts.length != 3
    raise "MARKETING_VERSION must be MAJOR.MINOR.PATCH (got #{current.inspect}). " \
          "Edit #{PROJECT_YML_PATH} to a three-segment value before bumping."
  end
  major, minor, patch = parts.map(&:to_i)
  case (kind || :patch).to_sym
  when :major then [major + 1, 0, 0].join(".")
  when :minor then [major, minor + 1, 0].join(".")
  when :patch then [major, minor, patch + 1].join(".")
  else raise "Unknown bump: #{kind.inspect}. Expected :major, :minor, or :patch."
  end
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Run the iOS test suite on the pinned iOS 18.x simulator (dodges iOS 26.x HostedView regression — see ios/CLAUDE.md)"
  lane :test do
    run_tests(
      scheme: SCHEME,
      destination: "platform=iOS Simulator,name=#{TEST_SIM_NAME},OS=#{TEST_IOS_VERSION}",
      clean: false,
      code_coverage: false,
      skip_slack: true
    )
  end

  desc "Watcher: run the iOS test suite against the latest iOS 26.x simulator (expected to fail until Apple fixes the HostedView regression)"
  lane :test_ios26_watch do
    run_tests(
      scheme: SCHEME,
      destination: "platform=iOS Simulator,name=#{TEST_SIM_NAME},OS=#{TEST_IOS_26_WATCH_VERSION}",
      clean: false,
      code_coverage: false,
      skip_slack: true
    )
  end

  desc "Load App Store Connect API key"
  lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
      duration: 1200,
      in_house: false
    )
  end

  desc "Create or fetch Apple Distribution certificate"
  lane :create_certificate do
    load_asc_api_key

    get_certificates(generate_apple_certs: true)
  end

  desc "Fetch or create App Store provisioning profile"
  lane :sync_profiles do
    load_asc_api_key

    get_provisioning_profile(
      app_identifier: APP_IDENTIFIER
    )
    get_provisioning_profile(
      app_identifier: NOTIFICATION_SERVICE_EXTENSION_IDENTIFIER
    )
  end

  desc "Increment build number (latest from ASC) and bump MARKETING_VERSION semantically. Pass bump: :major | :minor | :patch (default :patch), or skip_marketing_bump:true to bump build only (e.g. for a TestFlight-only hotfix)."
  lane :bump_build_number do |options|
    load_asc_api_key

    current_build = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    new_build = current_build + 1

    current_version = read_project_yml_setting("MARKETING_VERSION")
    if options[:skip_marketing_bump]
      new_version = current_version
      UI.message("Skipping marketing version bump (already at #{current_version})")
    else
      new_version = bump_marketing_version(current_version, options[:bump])
      update_project_yml_setting("MARKETING_VERSION", new_version)
    end

    update_project_yml_setting("CURRENT_PROJECT_VERSION", new_build.to_s)

    # Regenerate LaughTrack.xcodeproj so the new build settings land in pbxproj. Info.plist
    # embeds $(CURRENT_PROJECT_VERSION) / $(MARKETING_VERSION) and is unaffected.
    Dir.chdir("..") do
      sh("xcodegen", "generate")
    end

    # Commit + push the bump so tag_release tags a HEAD that is reachable on origin.
    # Without this, the working tree is dirty after release/beta runs end-to-end and
    # tag_release adds the tag against the unbumped HEAD commit — git checkout v1.1-N
    # would land on a commit whose project.yml + pbxproj still carry the old build
    # number. Pushing the commit first is required for the subsequent tag_release
    # step: push_git_tags refuses tags pointing at commits not reachable on the
    # remote. tags: false keeps this push commits-only — tag_release pushes its own
    # tag separately. The CI guard added in TASK-1902 (CURRENT_PROJECT_VERSION must
    # not decrease vs origin/main) makes this drift between "bumped on disk" and
    # "committed in git" especially dangerous, since the next operator can land a
    # PR that silently regresses the build number.
    # git_commit runs inside fastlane's workspace_dir (the parent of the
    # fastlane/ folder = ios/), unlike Fastfile helper methods which run from
    # ios/fastlane/. Paths here must be workspace-relative (no ../) — the
    # File.read calls in read_project_yml_setting use ../project.yml because
    # *those* run from ios/fastlane/. Keep both forms in mind.
    git_commit(
      path: ["project.yml", "LaughTrack.xcodeproj/project.pbxproj"],
      message: "[fastlane] Bump build to #{new_build}"
    )
    # Omit local_branch so fastlane resolves the actual current branch via
    # Actions.git_branch_name_using_HEAD; passing "HEAD" would assemble
    # `git push origin HEAD:HEAD`, which the remote refuses (refusing to
    # update checked out branch). tags: false keeps this push commits-only —
    # tag_release pushes its own tag separately.
    push_to_git_remote(
      remote: "origin",
      tags: false
    )

    UI.success("Bumped version #{current_version} → #{new_version}, build → #{new_build}")
  end

  desc "Build the app for App Store distribution"
  lane :build do |options|
    load_asc_api_key

    get_provisioning_profile(
      app_identifier: APP_IDENTIFIER
    )
    app_profile_name = lane_context[SharedValues::SIGH_NAME]

    get_provisioning_profile(
      app_identifier: NOTIFICATION_SERVICE_EXTENSION_IDENTIFIER
    )
    extension_profile_name = lane_context[SharedValues::SIGH_NAME]

    build_app(
      scheme: SCHEME,
      output_directory: "./build",
      output_name: IPA_NAME,
      export_method: "app-store",
      clean: true,
      # The archive step runs xcodebuild with automatic signing (the project
      # sets no CODE_SIGN_STYLE). After the Push Notifications capability was
      # added (aps-environment entitlement), automatic signing's managed profile
      # must include Push — -allowProvisioningUpdates lets xcodebuild regenerate
      # it via the loaded ASC API key. Without this the archive fails with
      # "provisioning profile doesn't include the aps-environment entitlement".
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_IDENTIFIER => app_profile_name,
          NOTIFICATION_SERVICE_EXTENSION_IDENTIFIER => extension_profile_name
        }
      }
    )
  end

  desc "Upload to TestFlight"
  lane :upload_testflight do
    load_asc_api_key

    upload_to_testflight(
      ipa: "./build/#{IPA_NAME}",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  # simctl lists the installed iOS-18 simulator runtime as "iOS 18.3" but
  # its underlying build is "18.3.1 - 22D8075" (verify: `xcrun simctl list
  # runtimes`). xcodebuild's -destination matcher requires the build's
  # patch version ("OS:18.3.1" appears in `xcodebuild -showdestinations`),
  # so snapshot's auto-built destination of OS=18.3 (sourced from simctl)
  # errors out with "Unable to find a device matching the provided
  # destination specifier" on every retry. Rewrite the destination string
  # immediately before xcodebuild runs. Drop this when fastlane snapshot
  # reads the build version from xcodebuild instead of simctl, or when the
  # next installed runtime's simctl name and build version agree again.
  def patch_snapshot_destination_for_18_3_1
    require 'snapshot/test_command_generator'
    sclass = Snapshot::TestCommandGenerator.singleton_class
    return if sclass.method_defined?(:__destination_unpatched) ||
              sclass.private_method_defined?(:__destination_unpatched)
    sclass.class_eval do
      alias_method :__destination_unpatched, :destination
      define_method(:destination) do |devices|
        __destination_unpatched(devices).map { |arg| arg.gsub("OS=18.3'", "OS=18.3.1'") }
      end
    end
  end

  # Start the Snapfile device and remove the installed app so its one-hour home
  # feed cache cannot leak into a new store capture. Uninstalling only LaughTrack
  # preserves the booted simulator's OS state and avoids the several-minute data
  # migration triggered by a full simulator erase.
  def boot_screenshot_simulator
    require "json"

    devices = JSON.parse(sh("xcrun simctl list devices available -j", log: false))
                  .fetch("devices")
                  .values
                  .flatten
    device = devices.find { |candidate| candidate["name"] == "iPhone 16 Pro Max" }
    UI.user_error!("No available 'iPhone 16 Pro Max' simulator found. Install the configured Xcode runtime before running screenshots.") if device.nil?

    UI.message("Booting iOS screenshot simulator #{device['udid']}…")
    sh("xcrun simctl bootstatus #{device['udid']} -b")
    UI.message("Clearing persisted LaughTrack screenshot state…")
    system(
      "xcrun", "simctl", "uninstall", device["udid"], "app.laughtrack.ios",
      out: File::NULL,
      err: File::NULL
    )
  end

  desc "Capture a complete iOS matrix, validate its run manifest, and export the App Store projection"
  lane :screenshots do |options|
    Dir.mktmpdir("laughtrack-ios-screenshots") do |tmpdir|
      capture_root = File.join(tmpdir, "capture")
      run_root = options[:run_root] ? File.expand_path(options[:run_root], REPO_ROOT) : File.join(tmpdir, "run")
      force_fresh = options[:force_fresh].to_s == "true"
      cache_plan = plan_ios_screenshot_cache(capture_root, force_fresh: force_fresh)
      pending_ids = cache_plan.fetch("pending_profiles")
      pending_profiles = IOS_SCREENSHOT_PROFILES.select { |profile| pending_ids.include?(profile.fetch(:id)) }
      cache_plan.fetch("reused_profiles").each do |profile_id|
        UI.success("Reusing cached iOS screenshot profile #{profile_id}")
      end

      build_duration = 0.0
      capture_duration = 0.0
      unless pending_profiles.empty?
        with_screenshot_fixture_server do
          boot_screenshot_simulator
          patch_snapshot_destination_for_18_3_1
          UI.message("Using persistent screenshot DerivedData: #{SCREENSHOT_DERIVED_DATA_PATH}")
          build_started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
          run_tests(
            project: "LaughTrack.xcodeproj",
            scheme: SCHEME,
            destination: "generic/platform=iOS Simulator",
            build_for_testing: true,
            derived_data_path: SCREENSHOT_DERIVED_DATA_PATH,
            clean: false,
            code_coverage: false,
            skip_slack: true,
            only_testing: ["LaughTrackUITests/AppStoreScreenshotTests/testGenerateAllScreenshots"],
            xcargs: "TARGETED_DEVICE_FAMILY=1,2",
            skip_package_dependencies_resolution: true,
            disable_package_automatic_updates: true,
            skip_package_repository_fetches: true,
          )
          build_duration = Process.clock_gettime(Process::CLOCK_MONOTONIC) - build_started_at

          capture_started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
          capture_screenshots(
            output_directory: capture_root,
            derived_data_path: SCREENSHOT_DERIVED_DATA_PATH,
            test_without_building: true,
            devices: pending_profiles.map { |profile| profile.fetch(:device_name) },
            clear_previous_screenshots: false,
          )
          capture_duration = Process.clock_gettime(Process::CLOCK_MONOTONIC) - capture_started_at
          pending_profiles.each do |profile|
            profile_id = profile.fetch(:id)
            store_ios_screenshot_profile(
              capture_root,
              profile_id,
              cache_plan.fetch("profile_fingerprints").fetch(profile_id),
            )
          end
        end
      end

      validate_ios_screenshot_collection(capture_root)
      export_app_store_projection(capture_root, run_root)
      UI.success(format("Screenshot timings: build=%.1fs capture=%.1fs", build_duration, capture_duration))
      UI.success("Validated iOS screenshot run manifest: #{File.join(run_root, 'manifest.json')}")
    end
  end

  desc "Add device frames and captions to screenshots"
  lane :frames do
    frame_screenshots(
      path: "./fastlane/screenshots",
      force_device_type: "iPhone 16 Pro Max"
    )
  end

  desc "Capture screenshots and upload them to App Store Connect"
  # frame_screenshots produces 1470x3000 PNGs (raw 1320x2868 + padded device
  # chrome) which Apple's App Store Connect refuses for iPhone 6.9" — the
  # only accepted sizes are 1320x2868 and 2868x1320. Keep the `frames` lane
  # available for marketing exports but don't chain it into the upload path.
  lane :screenshots_and_upload do
    screenshots
    upload_metadata
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :upload_metadata do
    load_asc_api_key

    deliver(
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      app_review_information: {
        demo_account_required: false
      }
    )
  end

  desc "Upload IPA + metadata + screenshots to ASC in one deliver call (creates the version record)"
  lane :upload_app_store do
    load_asc_api_key

    deliver(
      ipa: "./build/#{IPA_NAME}",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      skip_binary_upload: false,
      precheck_include_in_app_purchases: false,
      app_review_information: {
        demo_account_required: false
      }
    )
  end

  desc "Submit for App Store review (includes metadata + screenshots)"
  lane :submit_review do
    load_asc_api_key

    deliver(
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      submission_information: {
        add_id_info_uses_idfa: false
      },
      precheck_include_in_app_purchases: false,
      app_review_information: {
        demo_account_required: false
      }
    )
  end

  desc "Full pipeline: release notes, screenshots, bump build, build, upload, and submit for review. Pass bump: :major | :minor | :patch (default :patch)."
  # See screenshots_and_upload comment: `frames` produces App-Store-incompatible
  # 1470x3000 PNGs, so it's excluded from this pipeline too. The framed images
  # remain available via the standalone `frames` lane for marketing exports.
  lane :release do |options|
    generate_release_notes
    screenshots
    bump_build_number(bump: options[:bump], skip_marketing_bump: options[:skip_marketing_bump])
    build
    upload_testflight
    submit_review
    tag_release
  end

  desc "Build and upload to App Store Connect (creates version, uploads metadata + screenshots, pushes to TestFlight). Pass bump: :major | :minor | :patch (default :patch), or skip_marketing_bump:true to reuse the current MARKETING_VERSION (TestFlight-only hotfix)."
  lane :beta do |options|
    generate_release_notes
    bump_build_number(bump: options[:bump], skip_marketing_bump: options[:skip_marketing_bump])
    build
    upload_app_store
    tag_release
  end

  desc "Tag the current commit with v{version}-{build}"
  lane :tag_release do
    version = read_project_yml_setting("MARKETING_VERSION")
    build_num = read_project_yml_setting("CURRENT_PROJECT_VERSION")
    tag = "v#{version}-#{build_num}"

    if git_tag_exists(tag: tag)
      UI.important("Tag #{tag} already exists, skipping")
    else
      add_git_tag(tag: tag)
      push_git_tags(tag: tag)
      UI.success("Tagged #{tag}")
    end
  end

  desc "Generate release notes from commits since the last tag"
  lane :generate_release_notes do
    tag = last_git_tag

    if tag.nil? || tag.empty?
      UI.important("No previous tag found — using last 50 commits that touched ios/")
      raw = changelog_from_git_commits(commits_count: 50, pretty: "%s", app_path: ".")
    else
      raw = changelog_from_git_commits(between: [tag, "HEAD"], pretty: "%s", app_path: ".")
    end

    lines = raw.split("\n").map(&:strip).reject(&:empty?)

    entries = lines.reject { |line| line.match?(/^Merge |^Co-Authored-By:/i) }

    features = []
    fixes = []
    improvements = []

    entries.each do |summary|
      lower = summary.downcase
      if lower.match?(/\bfix(es|ed)?\b|\bbug\b|\bcrash\b|\bresolve[sd]?\b|\bpatch\b/)
        fixes << summary
      elsif lower.match?(/\badd(s|ed)?\b|\bnew\b|\bcreate[sd]?\b|\bintroduce[sd]?\b|\bimplement[sed]?\b|\bfeature\b/)
        features << summary
      else
        improvements << summary
      end
    end

    sections = []
    sections << "New Features\n#{features.map { |f| "• #{f}" }.join("\n")}" unless features.empty?
    sections << "Bug Fixes\n#{fixes.map { |f| "• #{f}" }.join("\n")}" unless fixes.empty?
    sections << "Improvements\n#{improvements.map { |f| "• #{f}" }.join("\n")}" unless improvements.empty?

    notes_text = sections.empty? ? "• Bug fixes and performance improvements" : sections.join("\n\n")

    max_len = 4000
    if notes_text.length > max_len
      truncated = notes_text[0...max_len]
      last_newline = truncated.rindex("\n")
      notes_text = last_newline ? truncated[0...last_newline] : truncated
    end

    release_notes_path = File.join(Dir.pwd, "metadata", "en-US", "release_notes.txt")
    FileUtils.mkdir_p(File.dirname(release_notes_path))
    File.write(release_notes_path, notes_text)
    UI.success("Wrote release_notes.txt (#{notes_text.length} chars)")

    notes_text
  end
end
