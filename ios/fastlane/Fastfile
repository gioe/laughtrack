SCREENSHOT_SIMULATOR_BOOT_TIMEOUT_SECONDS = Integer(
  ENV.fetch("LAUGHTRACK_SCREENSHOT_BOOT_TIMEOUT_SECONDS", "120"),
  10,
)
unless SCREENSHOT_SIMULATOR_BOOT_TIMEOUT_SECONDS.positive?
  raise "LAUGHTRACK_SCREENSHOT_BOOT_TIMEOUT_SECONDS must be positive"
end
